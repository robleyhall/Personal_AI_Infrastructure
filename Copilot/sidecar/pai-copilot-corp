#!/usr/bin/env bash
# pai-copilot-corp — slim corporate sidecar wrapper around `copilot`
#
# Derivative of pai-copilot. Stripped of voice-server integration and
# terminal-tab-title setting for corporate environments where those are
# unnecessary or conflict with corp audio/terminal policies.
#
# Kept (required for deterministic memory loading — see tasks/lessons.md #9):
#   - Env var export (PAI_DIR, PAI_USER_DIR, PAI_SESSION_ID)
#   - startup-digest.md materialization via learning-readback.sh
#   - Session start/end logging
#   - Stale-state cleanup on exit
#
# Removed (Tier 4 / out of scope for corporate bundle):
#   - start_voice_server
#   - set_tab_title
#   - PAI_VOICE_URL
#
# Exit code matches the wrapped `copilot` exit code. User can bypass this
# wrapper entirely by running `copilot` directly — it is a convenience,
# not a control boundary.

set -uo pipefail

PAI_DIR="${PAI_DIR:-$HOME/.pai}"
PAI_USER_DIR="${PAI_USER_DIR:-$PAI_DIR/USER}"
PAI_STATE_DIR="$PAI_DIR/state"
PAI_LOG_DIR="$PAI_DIR/logs"
SESSION_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"

mkdir -p "$PAI_STATE_DIR" "$PAI_LOG_DIR"

log() {
  printf '%s [pai-copilot-corp] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$PAI_LOG_DIR/sidecar.log"
}

materialize_startup_digest() {
  # Deterministic: generate the learning digest *before* Copilot starts so
  # the instruction file can reference a static file rather than relying on
  # the AI remembering to run a script.
  local readback="$PAI_DIR/tools/learning-readback.sh"
  local digest_file="$PAI_DIR/MEMORY/LEARNING/startup-digest.md"
  mkdir -p "$(dirname "$digest_file")"
  if [[ -x "$readback" ]]; then
    "$readback" > "$digest_file" 2>/dev/null || true
    local size
    size="$(wc -c < "$digest_file" 2>/dev/null | tr -d ' ')"
    log "startup-digest materialised (${size:-0} bytes)"
  else
    log "learning-readback.sh not found or not executable at $readback"
  fi
}

pre_session() {
  export PAI_DIR PAI_USER_DIR PAI_SESSION_ID="$SESSION_ID"

  materialize_startup_digest

  log "session-start id=$SESSION_ID cwd=$PWD"
  echo "$SESSION_ID $(date -u +%s) start" >>"$PAI_STATE_DIR/sessions.log"
}

cleanup_stale_state() {
  find "$PAI_STATE_DIR" -maxdepth 1 -type f -name "*.tmp" -mtime +7 -delete 2>/dev/null || true
  find "$PAI_STATE_DIR" -maxdepth 1 -type f -name "*.signal" -mtime +7 -delete 2>/dev/null || true
  find "$PAI_DIR/MEMORY/WORK" -mindepth 1 -type d -empty -delete 2>/dev/null || true
  log "cleanup complete"
}

post_session() {
  local exit_code="$1"
  log "session-end id=$SESSION_ID exit=$exit_code"
  echo "$SESSION_ID $(date -u +%s) end $exit_code" >>"$PAI_STATE_DIR/sessions.log"
  cleanup_stale_state
}

require_copilot() {
  if ! command -v copilot >/dev/null 2>&1; then
    echo "pai-copilot-corp: \`copilot\` CLI not found in PATH." >&2
    echo "Install: https://docs.github.com/copilot/using-github-copilot/using-github-copilot-in-the-cli" >&2
    exit 127
  fi
}

main() {
  require_copilot
  pre_session

  copilot "$@"
  local code=$?

  post_session "$code"
  exit "$code"
}

trap 'post_session 130' INT TERM

main "$@"
