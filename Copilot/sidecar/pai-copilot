#!/usr/bin/env bash
# pai-copilot — sidecar wrapper around `copilot`
#
# Replaces PAI's Claude Code hook system (SessionStart / SessionEnd) with
# shell-level pre/post phases. The AI still handles in-session hooks
# (UserPromptSubmit, Stop) via instruction-based rules in copilot-instructions.md.
#
# Responsibilities:
#   PRE:   Export env vars, ensure voice server, set tab title, log session start
#   RUN:   exec copilot with any args the user passed
#   POST:  Log session end, reset tab title (on normal exit)

set -uo pipefail

PAI_DIR="${PAI_DIR:-$HOME/.pai}"
PAI_STATE_DIR="$PAI_DIR/state"
PAI_LOG_DIR="$PAI_DIR/logs"
PAI_VOICE_URL="${PAI_VOICE_URL:-http://localhost:8888}"
SESSION_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"

mkdir -p "$PAI_STATE_DIR" "$PAI_LOG_DIR"

log() {
  printf '%s [pai-copilot] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$PAI_LOG_DIR/sidecar.log"
}

set_tab_title() {
  # OSC 0 sets icon + window title in most terminals (iTerm2, Kitty, Terminal.app).
  printf '\033]0;%s\007' "$1"
}

start_voice_server() {
  if curl -sf "$PAI_VOICE_URL/health" >/dev/null 2>&1; then
    log "voice-server already running"
    return 0
  fi

  local start_script="$PAI_DIR/VoiceServer/start.sh"
  if [[ -x "$start_script" ]]; then
    "$start_script" >/dev/null 2>&1 || log "voice-server failed to start"
  else
    log "voice-server start script not found at $start_script"
  fi
}

materialize_startup_digest() {
  # Deterministic: generate the learning digest *before* Copilot starts so
  # the instruction file can reference a static file rather than relying on
  # the AI remembering to run a script.
  local readback="$PAI_DIR/tools/learning-readback.sh"
  local digest_file="$PAI_DIR/MEMORY/LEARNING/startup-digest.md"
  if [[ -x "$readback" ]]; then
    "$readback" > "$digest_file" 2>/dev/null || true
    log "startup-digest materialised ($(wc -c < "$digest_file" | tr -d ' ') bytes)"
  fi
}

# capture_engagement — record one line of project-engagement signal per launch.
# Only fires when $PWD is inside a git repo; otherwise no-op. Appends JSONL to
# $PAI_DIR/MEMORY/WORK/projects/engagement.jsonl. Per-project markdown files
# are (re)built by engagement-distill.sh, which learning-readback.sh calls.
capture_engagement() {
  local repo_root
  repo_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" || return 0
  [[ -n "$repo_root" ]] || return 0

  local projects_dir="$PAI_DIR/MEMORY/WORK/projects"
  mkdir -p "$projects_dir"

  local repo_slug
  repo_slug="$(basename "$repo_root" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"

  local open_todos=0
  for todo_file in "$repo_root/tasks/todo.md" "$repo_root/TODO.md" "$repo_root/tasks/TODO.md"; do
    if [[ -f "$todo_file" ]]; then
      local c
      # grep -c always prints a count on stdout; swallow its non-zero exit on no-match.
      c="$(grep -cE '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$todo_file" 2>/dev/null)" || c=0
      # Guard against empty or multi-line content.
      [[ "$c" =~ ^[0-9]+$ ]] || c=0
      open_todos=$((open_todos + c))
    fi
  done

  local ts
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # Escape paths for JSON (backslash and double-quote).
  local esc_root esc_cwd
  esc_root="$(printf '%s' "$repo_root" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  esc_cwd="$(printf '%s' "$PWD" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"

  printf '{"ts":"%s","session_id":"%s","cwd":"%s","repo_root":"%s","repo_slug":"%s","open_todos":%d}\n' \
    "$ts" "$SESSION_ID" "$esc_cwd" "$esc_root" "$repo_slug" "$open_todos" \
    >>"$projects_dir/engagement.jsonl"

  log "engagement captured repo=$repo_slug open_todos=$open_todos"
}

pre_session() {
  export PAI_DIR PAI_SESSION_ID="$SESSION_ID"

  set_tab_title "PAI"
  start_voice_server
  capture_engagement
  materialize_startup_digest

  log "session-start id=$SESSION_ID cwd=$PWD"
  echo "$SESSION_ID $(date -u +%s) start" >>"$PAI_STATE_DIR/sessions.log"
  touch "$PAI_STATE_DIR/session-${SESSION_ID}.started"
}

post_session() {
  local exit_code="$1"
  log "session-end id=$SESSION_ID exit=$exit_code"
  echo "$SESSION_ID $(date -u +%s) end $exit_code" >>"$PAI_STATE_DIR/sessions.log"
  set_tab_title "Terminal"
  cleanup_stale_state
  post_session_tier3
}

cleanup_stale_state() {
  # Remove signal/temp files older than 7 days from state dir
  find "$PAI_STATE_DIR" -maxdepth 1 -type f -name "*.tmp" -mtime +7 -delete 2>/dev/null || true
  find "$PAI_STATE_DIR" -maxdepth 1 -type f -name "*.signal" -mtime +7 -delete 2>/dev/null || true

  # Remove empty directories under MEMORY/WORK (abandoned PRD dirs)
  find "$PAI_DIR/MEMORY/WORK" -mindepth 1 -type d -empty -delete 2>/dev/null || true

  log "cleanup complete"
}

# weekly_synthesis — run LearningPatternSynthesis once per ISO week.
# Stamp-file gated; non-fatal. Replaces upstream's cron-style
# LearningPatternSynthesis.hook.ts (Copilot CLI has no hook API).
weekly_synthesis() {
  local stamp="$PAI_STATE_DIR/last-synthesis.stamp"
  local week_now
  week_now="$(date -u +%G-W%V)"
  local week_last=""
  [[ -f "$stamp" ]] && week_last="$(cat "$stamp" 2>/dev/null || true)"

  if [[ "$week_now" == "$week_last" ]]; then
    log "synthesis skipped (already ran week $week_now)"
    return 0
  fi

  # Invoke the bun-native upstream tool directly (ported to ~/.pai/PAI/Tools/).
  local synth="$PAI_DIR/PAI/Tools/LearningPatternSynthesis.ts"
  if [[ -f "$synth" ]] && command -v bun >/dev/null 2>&1; then
    if bun "$synth" --week >>"$PAI_LOG_DIR/synthesis.log" 2>&1; then
      printf '%s\n' "$week_now" >"$stamp"
      log "synthesis ran for week $week_now"
    else
      log "synthesis failed for week $week_now (see synthesis.log)"
    fi
  else
    log "synthesis skipped (bun or tool missing)"
  fi
}

# integrity_scan — regression guard for phantom-PAI-root refs in skills/.
# Logs findings to integrity.log; never blocks session exit.
# Upstream equivalent: IntegrityMaintenance.ts + DocIntegrity.hook.ts.
integrity_scan() {
  local skills_dir="$PAI_DIR/skills"
  local log_file="$PAI_LOG_DIR/integrity.log"
  [[ -d "$skills_dir" ]] || return 0

  local ts hits
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Phantom patterns: Tier 1 deliberately skipped PAI/SKILL.md, PAI/Tools/, PAI/Prompting.md.
  hits="$(grep -rlE '~/\.pai/PAI/(SKILL\.md|Tools/|Prompting\.md)' "$skills_dir" 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "${hits:-0}" -gt 0 ]]; then
    printf '%s integrity-scan phantom-ref-count=%d\n' "$ts" "$hits" >>"$log_file"
  fi
}

post_session_tier3() {
  # Tier 3 additions: weekly synthesis + integrity regression scan.
  # Both non-fatal.
  weekly_synthesis
  integrity_scan
  prd_sync
}

# prd_sync — approximates upstream PRDSync.hook.ts (PostToolUse/Write+Edit).
# Bumps `updated:` timestamp in any MEMORY/WORK/<slug>/*.md PRD files that
# were modified during this session. Only touches files with PRDFORMAT v2.0
# frontmatter (first 10 lines contain `task:` and `updated:`).
prd_sync() {
  local workdir="$PAI_DIR/MEMORY/WORK"
  [[ -d "$workdir" ]] || return 0
  local session_start="$PAI_STATE_DIR/session-${SESSION_ID}.started"
  [[ -f "$session_start" ]] || return 0
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Find PRD files modified since session start
  find "$workdir" -type f -name '*.md' -newer "$session_start" -print 2>/dev/null | while read -r f; do
    # Must be PRDFORMAT v2.0 (has task: + updated: in first 12 lines)
    head -12 "$f" | grep -qE '^task:' || continue
    head -12 "$f" | grep -qE '^updated:' || continue
    # Bump updated: in place (macOS sed compatible)
    /usr/bin/sed -i '' -E "1,12 s|^updated:.*|updated: ${now}|" "$f" 2>/dev/null && \
      log "prd_sync: bumped updated in $(basename "$(dirname "$f")")/$(basename "$f")"
  done >>"$PAI_LOG_DIR/prd-sync.log" 2>&1 || true
}

require_copilot() {
  if ! command -v copilot >/dev/null 2>&1; then
    echo "pai-copilot: \`copilot\` CLI not found in PATH." >&2
    echo "Install: https://docs.github.com/copilot/using-github-copilot/using-github-copilot-in-the-cli" >&2
    exit 127
  fi
}

main() {
  require_copilot
  pre_session

  # Forward all args + signals to copilot. We intentionally do NOT wrap stdin/stdout
  # in a PTY — Copilot CLI manages its own TUI and we want zero interference.
  # Always allow file access to $PAI_DIR so PAI memory/tools/skills are reachable
  # without per-session /add-dir prompts.
  copilot --add-dir "$PAI_DIR" "$@"
  local code=$?

  post_session "$code"
  exit "$code"
}

trap 'post_session 130' INT TERM

main "$@"
